# Frontend + API are served from the same origin (nginx proxies /api -> Node),
# so this is same-origin: no CORS. These VITE_ vars are baked into the bundle
# at build time and are public by design — never put secrets here.
VITE_API_ORIGIN=https://club.lialijewellery.com

# Shopify storefront origin — used to build the App Proxy entry
# (<SHOP_ORIGIN>/apps/club) that checks whether the visitor is logged in.
VITE_SHOP_ORIGIN=https://lialijewellery.com
